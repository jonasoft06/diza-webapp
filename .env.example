# Public origin of the site, without a trailing slash. It is the base of the canonical URLs, the social
# preview images (og:image), the sitemap and the structured data. Read at build time: set it in the
# environment that builds the site (e.g. the hosting provider's variables) and rebuild after changing it.
# If it is missing or invalid the site uses https://diza.com.mx.
NEXT_PUBLIC_SITE_URL=https://diza.com.mx
